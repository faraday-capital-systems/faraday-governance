{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faraday-capital-systems.github.io/faraday-governance/review-policy/policy.schema.json",
  "title": "FaradayReviewPolicyBundle",
  "description": "Validates the four YAML files of the Faraday Review policy bundle, assembled into one object keyed by file basename (without extension). approval_authorized and merge_authorized are schema-pinned to false in Phase 1: enabling either requires a new policy_version AND a new schema, which changes the bundle digest and therefore the pin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval-policy",
    "protected-paths",
    "evidence-requirements",
    "provider-requirements"
  ],
  "properties": {
    "approval-policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "authority", "consumer", "risk_classes", "block_conditions"],
      "properties": {
        "policy_version": { "$ref": "#/$defs/policy_version" },
        "authority": { "const": "faraday-capital-systems/faraday-governance" },
        "consumer": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "risk_classes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["green", "yellow", "red", "block"],
          "properties": {
            "green": { "$ref": "#/$defs/risk_class_policy" },
            "yellow": { "$ref": "#/$defs/risk_class_policy" },
            "red": { "$ref": "#/$defs/risk_class_policy" },
            "block": { "$ref": "#/$defs/risk_class_policy" }
          }
        },
        "block_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        }
      }
    },
    "protected-paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "default_class", "classes"],
      "properties": {
        "policy_version": { "$ref": "#/$defs/policy_version" },
        "default_class": { "enum": ["yellow", "red"] },
        "classes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "yellow", "green"],
          "properties": {
            "red": { "$ref": "#/$defs/pattern_list" },
            "yellow": { "$ref": "#/$defs/pattern_list" },
            "green": { "$ref": "#/$defs/pattern_list" }
          }
        }
      }
    },
    "evidence-requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "evidence_contract",
        "contracts_source",
        "minimum_contract_version",
        "accepted_contract_minors_back",
        "accepted_evidence_classes",
        "sha_binding",
        "deterministic_checks_required",
        "secret_findings"
      ],
      "properties": {
        "policy_version": { "$ref": "#/$defs/policy_version" },
        "evidence_contract": { "const": "pull-request-review-evidence" },
        "contracts_source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "minimum_contract_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "accepted_contract_minors_back": { "const": 1 },
        "accepted_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["deterministic", "mixed"] }
        },
        "sha_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "case", "short_shas_rejected", "freshness", "refetch_points"],
          "properties": {
            "format": { "const": "full_40_hex" },
            "case": { "const": "lowercase_normalized_by_producer" },
            "short_shas_rejected": { "const": true },
            "freshness": { "const": "head_sha_must_match_refetched_head" },
            "refetch_points": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["before_validation", "before_publication"] }
            }
          }
        },
        "deterministic_checks_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "secret_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocking", "matched_value_forbidden_everywhere"],
          "properties": {
            "blocking": { "const": true },
            "matched_value_forbidden_everywhere": { "const": true }
          }
        }
      }
    },
    "provider-requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "required_providers", "adversary_required_paths", "deterministic_only"],
      "properties": {
        "policy_version": { "$ref": "#/$defs/policy_version" },
        "required_providers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "adversary_required_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deterministic_only": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pattern_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_class_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "approval_authorized", "merge_authorized", "founder_review_required"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "approval_authorized": { "const": false },
        "merge_authorized": { "const": false },
        "founder_review_required": { "type": "boolean" }
      }
    }
  }
}
